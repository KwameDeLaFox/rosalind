# The app uses DeepSeek (OpenAI-compatible) as the LLM provider.
# Get an API key at https://platform.deepseek.com.
#
# Set this env var locally (or in your host's dashboard):
#
#   DEEPSEEK_API_KEY=sk-...
#
# Optional overrides:
#   DEEPSEEK_BASE_URL=https://api.deepseek.com   (default)
#   DEEPSEEK_MODEL=deepseek-flash                (default — V4.1-Flash, text + vision)
#
# .env is in .gitignore and will never be committed.
